# Merge these locations into the HTTPS server for example.com.
upstream vision_hls_backend {
    server 127.0.0.1:18888;
    keepalive 8;
}

server {
    listen 443 ssl http2;
    server_name example.com;
    ssl_certificate     /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;

    location = /vision { return 301 /vision/; }

    location = /vision/whep {
        proxy_pass http://127.0.0.1:8889/vision/whep;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
    }

    location ^~ /vision/ {
        alias /var/www/vision/;
        index index.html;
        try_files $uri $uri/ =404;
    }

    # Legacy FRP HLS fallback. It is inactive while FRP and board HLS are off.
    location = /vision-hls { return 301 /vision-hls/; }
    location ^~ /vision-hls/ {
        proxy_pass http://vision_hls_backend/vision/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
    }
}
