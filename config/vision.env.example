# 家庭视觉看护台统一配置。复制为 vision.env 后填写密钥；vision.env 不会提交到 Git。

# ByteTrack：使用 COCO 英文类别名，逗号分隔。例如 person,bottle。
YOLO_TRACK_CLASSES=person,cat,dog

# Dashboard：浏览器打开 http://板卡IP:8080 ，视频仍使用 MediaMTX 的 WebRTC 流。
DASHBOARD_ENABLED=yes
DASHBOARD_PORT=8080
VISION_EVENT_RETENTION_DAYS=30

# LLM：设为 no 时仍记录本地事实事件和 Dashboard，但不调用 API。
VISION_LLM_ENABLED=yes
LLM_API_KEY=replace_with_your_api_key
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MIN_CONFIDENCE=0.4
LLM_EVENT_COOLDOWN=10

# 成本控制：每 60 秒至多请求一次；每天达到额度后自动降级为本地事实文案。
LLM_MIN_REQUEST_INTERVAL=60
LLM_MAX_OUTPUT_TOKENS=120
LLM_DAILY_TOKEN_BUDGET=20000

# SRT 公网转发：五项全部留空时不启用；填写任意一项时必须全部填写。
# 密码/用户名使用 16–32 位字母、数字、_ 或 -；可用：tr -dc 'A-Za-z0-9_-' </dev/urandom | head -c 24
# VISION_SRT_CLOUD_HOST=example.com
# VISION_SRT_USERNAME=replace_with_publish_user
# VISION_SRT_PASSWORD=replace_with_publish_password
# VISION_SRT_PASSPHRASE=replace_with_24_char_secret
# VISION_SRT_LATENCY_MS=2000
